<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Self-contained: nothing here depends on MicroProxy, so the module can move to its own repository. -->
    <parent>
        <groupId>io.github.mahmoudimus</groupId>
        <artifactId>microproxy-parent</artifactId>
        <version>0.6.1-SNAPSHOT</version>
    </parent>

    <artifactId>quic</artifactId>
    <packaging>jar</packaging>

    <name>quic</name>
    <description>
        A QUIC (RFC 9000, RFC 9001, RFC 9002) implementation for JDK 21 and newer:
        packets, packet protection, a TLS 1.3 handshake for QUIC, streams, loss recovery and
        congestion control, with limits for untrusted peers.
    </description>

    <dependencies>
        <!-- Runtime for checked Dafny output; pinned independently in formal/crypto/delivery.json. -->
        <dependency>
            <groupId>org.dafny</groupId>
            <artifactId>DafnyRuntime</artifactId>
            <version>4.9.1</version>
        </dependency>
        <!-- Test only: an HTTP/3 server for the aioquic HTTP/3 interop test -->
        <dependency>
            <groupId>io.github.mahmoudimus</groupId>
            <artifactId>http3-codec</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!-- Match the canonical compiler used by the checked crypto delivery gate. -->
                    <debug>true</debug>
                    <debuglevel>lines,vars,source</debuglevel>
                    <encoding>UTF-8</encoding>
                    <compilerArgs>
                        <!-- Use javac for package metadata in both Maven and exact class comparison. -->
                        <arg>-Xpkginfo:always</arg>
                        <!-- Dafny emits redundant casts and raw tuple returns; retain other lint categories. -->
                        <!-- Final delivery separately checks handwritten main Java with the original strict lint. -->
                        <arg>-Xlint:all,-serial,-cast,-rawtypes</arg>
                    </compilerArgs>
                </configuration>
                <executions>
                    <execution>
                        <id>default-testCompile</id>
                        <configuration>
                            <!-- Tests are handwritten; preserve the original lint categories. -->
                            <compilerArgs combine.self="override">
                                <arg>-Xpkginfo:always</arg>
                                <arg>-Xlint:all,-serial</arg>
                            </compilerArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.mahmoudimus.quic</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
