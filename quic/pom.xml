<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Self-contained: nothing here depends on MicroProxy, so the module can move to its own repository. -->
    <parent>
        <groupId>io.github.mahmoudimus</groupId>
        <artifactId>microproxy-parent</artifactId>
        <version>0.2.0</version>
    </parent>

    <artifactId>quic</artifactId>
    <packaging>jar</packaging>

    <name>quic</name>
    <description>
        A dependency-free QUIC (RFC 9000, RFC 9001, RFC 9002) implementation for JDK 21 and newer:
        packets, packet protection, a TLS 1.3 handshake for QUIC, streams, loss recovery and
        congestion control, with limits for untrusted peers.
    </description>

    <dependencies>
        <!-- Test only: an HTTP/3 server for the aioquic HTTP/3 interop test -->
        <dependency>
            <groupId>io.github.mahmoudimus</groupId>
            <artifactId>http3-codec</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>io.github.mahmoudimus.quic</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
