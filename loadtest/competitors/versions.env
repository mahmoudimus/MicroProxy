# The external proxies of the load-testing comparison (docs/project/performance.md), pinned.
# setup.sh reads this file; change a version here and its checksum together.

# Envoy: the official release binary and its SHA-256, from the release's signed checksums.txt.asc.
ENVOY_VERSION=1.39.4
ENVOY_SHA256=75e87c490b953c959af46483ff3406dc15322187a8cac7be91b1477d090019bc

# Go toolchain for goproxy/ (the goproxy library's version and checksums are in go.mod and go.sum).
GO_VERSION=1.27.2
GO_SHA256=ecbadb99091a3f46e31f5f934b068b1864eafa7995211b39eaddf76996045fe5

# g3proxy: built from this tag of github.com/bytedance/g3, checked against its commit.
G3PROXY_VERSION=1.12.4
G3_COMMIT=49d5cd0f648bf7eb14184e2bd99398dc90469af5
# The Rust toolchain it was built with (installed with rustup-init when no cargo of this version is found).
RUST_VERSION=1.97.0

# Squid: the Ubuntu 24.04 package (apt; needs root).
SQUID_APT_VERSION=6.14-0ubuntu0.24.04.4
