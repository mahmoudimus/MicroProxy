<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.mahmoudimus</groupId>
    <artifactId>microproxy-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MicroProxy (parent)</name>
    <description>
        A dependency-free HTTP/HTTPS intercepting proxy built on blocking I/O and virtual threads
        (Project Loom). A port of LittleProxy without Netty.
    </description>
    <url>https://github.com/mahmoudimus/MicroProxy</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <modules>
        <!-- The proxy itself: no runtime dependencies. -->
        <module>microproxy</module>
        <!-- Optional: script the proxy in Starlark. -->
        <module>microproxy-starlark</module>
    </modules>

    <properties>
        <!-- Virtual threads are final in JDK 21; the code also runs unchanged on JDK 25+. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <guava.version>33.4.8-jre</guava.version>
        <auto-value.version>1.11.0</auto-value.version>
        <jsr305.version>3.0.2</jsr305.version>
        <errorprone.version>2.36.0</errorprone.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>microproxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- Surface virtual-thread pinning (JDK 21-23) during tests. -->
                        <argLine>-Djdk.tracePinnedThreads=short -Djava.util.logging.config.file=${maven.multiModuleProjectDirectory}/microproxy/src/test/resources/logging.properties</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
</project>
