<?xml version="1.0" encoding="UTF-8"?>
<project child.project.url.inherit.append.path="false" xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>io.github.mahmoudimus</groupId>
    <artifactId>microproxy-parent</artifactId>
    <version>0.2.0</version>
    <packaging>pom</packaging>

    <name>MicroProxy (parent)</name>
    <description>
        A dependency-free HTTP/HTTPS intercepting proxy built on blocking I/O and virtual threads
        (Project Loom). A port of LittleProxy without Netty.
    </description>
    <url>https://mahmoudimus.github.io/MicroProxy/</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
        </license>
    </licenses>

    <developers>
        <developer>
            <id>mahmoudimus</id>
            <name>Mahmoud Rusty Abdelkader</name>
            <url>https://github.com/mahmoudimus</url>
        </developer>
    </developers>

    <scm child.scm.connection.inherit.append.path="false" child.scm.developerConnection.inherit.append.path="false" child.scm.url.inherit.append.path="false">
        <connection>scm:git:https://github.com/mahmoudimus/MicroProxy.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/mahmoudimus/MicroProxy.git</developerConnection>
        <url>https://github.com/mahmoudimus/MicroProxy</url>
        <tag>v${project.version}</tag>
    </scm>

    <modules>
        <!-- A standalone pure-Java Zstandard decoder; the proxy uses it when present. -->
        <module>zstd-decoder</module>
        <!-- A standalone HTTP/2 frame codec and HPACK implementation. -->
        <module>http2-codec</module>
        <!-- A standalone HTTP/3 frame codec and QPACK implementation. -->
        <module>http3-codec</module>
        <!-- A standalone QUIC transport with its own TLS 1.3 handshake. -->
        <module>quic</module>
        <!-- The proxy itself: no required runtime dependencies. -->
        <module>microproxy</module>
        <!-- Optional: OpenTelemetry tracing and OTLP export, with no dependencies. -->
        <module>microproxy-otel</module>
        <!-- Optional: script the proxy in Starlark. -->
        <module>microproxy-starlark</module>
    </modules>

    <properties>
        <!-- Virtual threads are final in JDK 21; the code also runs unchanged on JDK 25+. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.11.4</junit.version>
        <guava.version>33.4.8-jre</guava.version>
        <auto-value.version>1.11.0</auto-value.version>
        <jsr305.version>3.0.2</jsr305.version>
        <errorprone.version>2.36.0</errorprone.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>microproxy</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>microproxy-otel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>zstd-decoder</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>http2-codec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>http3-codec</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.mahmoudimus</groupId>
                <artifactId>quic</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>3.13.0</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>3.5.2</version>
                    <configuration>
                        <!-- Surface virtual-thread pinning (JDK 21-23) during tests. -->
                        <argLine>-Djdk.tracePinnedThreads=short -Djava.util.logging.config.file=${maven.multiModuleProjectDirectory}/microproxy/src/test/resources/logging.properties</argLine>
                    </configuration>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.4.2</version>
                </plugin>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-shade-plugin</artifactId>
                    <version>3.6.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <!-- The aggregated Javadoc of the published modules, for the documentation site's /api/.
                     Not bound to a phase: CI runs it after building, with
                       mvn -B -DskipTests install
                       mvn -B javadoc:aggregate-no-fork@api-docs -Dmaven.javadoc.skip=true
                     The goal runs once per module of the reactor; maven.javadoc.skip skips the modules,
                     and this execution's skip=false keeps it at the root, where it reads every module.
                     The internals (org.microproxy.impl, see its README.md) and the vendored code
                     (org.microproxy.thirdparty) are not part of the public API, so they are left out. -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>3.12.0</version>
                <executions>
                    <execution>
                        <!-- Not inherited: the modules keep only the Central profile's javadoc jars. -->
                        <id>api-docs</id>
                        <inherited>false</inherited>
                        <phase>none</phase>
                        <goals><goal>aggregate-no-fork</goal></goals>
                        <configuration>
                            <skip>false</skip>
                            <doctitle>MicroProxy ${project.version} API</doctitle>
                            <windowtitle>MicroProxy ${project.version} API</windowtitle>
                            <additionalOptions>
                                <!-- org.microproxy.simd uses the incubating Vector API. -->
                                <additionalOption>--add-modules</additionalOption>
                                <additionalOption>jdk.incubator.vector</additionalOption>
                            </additionalOptions>
                            <excludePackageNames>org.microproxy.impl:org.microproxy.impl.*:org.microproxy.thirdparty:org.microproxy.thirdparty.*</excludePackageNames>
                            <groups>
                                <group>
                                    <title>Proxy (microproxy)</title>
                                    <packages>org.microproxy:org.microproxy.cache:org.microproxy.contentviews:org.microproxy.dns:org.microproxy.extras:org.microproxy.frames:org.microproxy.http:org.microproxy.quic:org.microproxy.simd:org.microproxy.stats:org.microproxy.tcp:org.microproxy.tls:org.microproxy.udp:org.microproxy.warc</packages>
                                </group>
                                <group>
                                    <title>OpenTelemetry (microproxy-otel)</title>
                                    <packages>org.microproxy.otel</packages>
                                </group>
                                <group>
                                    <title>Scripting (microproxy-starlark)</title>
                                    <packages>org.microproxy.starlark:org.microproxy.starlark.*</packages>
                                </group>
                                <group>
                                    <title>Codecs and QUIC (zstd-decoder, http2-codec, http3-codec, quic)</title>
                                    <packages>io.github.mahmoudimus.*</packages>
                                </group>
                            </groups>
                            <bottom>Copyright &#169; MicroProxy contributors. Apache License 2.0. &lt;a href="https://mahmoudimus.github.io/MicroProxy/"&gt;Documentation&lt;/a&gt;</bottom>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- Opt in only when checking or publishing Central artifacts. -->
            <id>central</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>3.3.1</version>
                        <executions>
                            <execution>
                                <id>sources</id>
                                <goals><goal>jar-no-fork</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>3.12.0</version>
                        <executions>
                            <execution>
                                <id>javadoc</id>
                                <goals><goal>jar</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.8</version>
                        <configuration>
                            <signer>bc</signer>
                            <bestPractices>true</bestPractices>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign</id>
                                <phase>verify</phase>
                                <goals><goal>sign</goal></goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.11.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
