include "../../../crypto/NativeKeccak.dfy"

// Functional correspondence for the proposed pure-call representation. These
// proofs complement the trusted binding checker; they do not prove that checker.
module SnapshotValueBridge {
  import T = NativeTypes
  import K = NativeKeccak

  method LocalValue(word: bv64, n: T.I) returns (value: bv64)
    requires 0 <= n < 64
    ensures value == K.Rotate(word,n).0
  {
    ghost var callWitness := K.Rotate(word,n);
    value := K.Rotate(word,n).0;
    assert value == callWitness.0;
    assert callWitness == K.Rotate(word,n);
  }

  // No cross-buffer exclusion: shared input/output arrays and equal indices are
  // included. The executable RHS reads the pre-write input value.
  method ArrayValue(input: array<bv64>, output: array<bv64>, i: T.I, j: T.I, n: T.I)
    requires 0 <= i as int < output.Length && 0 <= j as int < input.Length
    requires 0 <= n < 64
    modifies output
    ensures output[i] == K.Rotate(old(input[j]),n).0
  {
    ghost var before := input[j];
    ghost var callWitness := K.Rotate(input[j],n);
    output[i] := K.Rotate(input[j],n).0;
    assert output[i] == callWitness.0;
    assert callWitness == K.Rotate(before,n);
  }

  // Positive counterpart of the stale-value mutation generated by the runner.
  // A trace-only comparison would miss an intervening private-word mutation.
  method StableValue(a: array<bv64>)
    requires a.Length >= 2
    modifies a
  {
    ghost var callWitness := K.Rotate(a[0],1);
    // STALE-VALUE-CONTROL: insert a[0] := a[0] ^ 1 here.
    a[1] := K.Rotate(a[0],1).0;
    assert a[1] == callWitness.0;
  }
}
